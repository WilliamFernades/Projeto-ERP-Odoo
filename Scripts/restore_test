#!/bin/bash
set -euo pipefail

# ===== CONFIG =====
CONTAINER="postgres"
DB_USER="xxxx"
TEST_DB="test_restore"
BACKUP_DIR="/opt/erp-spark/backup/data"
LOG="$BACKUP_DIR/restore.log"
METRIC_FILE="/opt/erp-spark/backup/restore.prom"

# ===== GET LATEST BACKUP =====
LATEST=$(ls -t "$BACKUP_DIR"/*.sql.gz | head -n 1)

if [ -z "$LATEST" ]; then
    echo "[$(date)] ERRO: Nenhum backup encontrado" >> "$LOG"
    echo "restore_success 0" > "$METRIC_FILE"
    exit 1
fi

echo "[$(date)] Iniciando teste de restore com $LATEST" >> "$LOG"

START=$(date +%s)

# ===== Encerra todas sessões =========

echo "[$(date)] Encerrando conexões no banco test_restore..." >> "$LOG"

docker exec postgres psql -U odoo -d postgres -c "
SELECT pg_terminate_backend(pid)
FROM pg_stat_activity
WHERE datname = 'test_restore'
AND pid <> pg_backend_pid();
" >> "$LOG" 2>&1

# ===== DROP + CREATE =====
docker exec "$CONTAINER" psql -U "$DB_USER" -c "DROP DATABASE IF EXISTS $TEST_DB;" >> "$LOG" 2>&1
docker exec "$CONTAINER" psql -U "$DB_USER" -c "CREATE DATABASE $TEST_DB;" >> "$LOG" 2>&1

# ===== RESTORE =====
if gunzip -c "$LATEST" | docker exec -i "$CONTAINER" psql -U "$DB_USER" -d "$TEST_DB" >> "$LOG" 2>&1; then
    echo "[$(date)] Restore executado" >> "$LOG"
else
    echo "[$(date)] ERRO: Falha no restore" >> "$LOG"
    echo "restore_success 0" > "$METRIC_FILE"
    exit 1
fi

# ===== VALIDATION =====
CHECK=$(docker exec "$CONTAINER" psql -U "$DB_USER" -d "$TEST_DB" -t -c "SELECT count(*) FROM res_users;" | xargs)

END=$(date +%s)
DURATION=$((END - START))

if [ "$CHECK" -gt 0 ]; then
    echo "[$(date)] VALIDAÇÃO OK: res_users=$CHECK" >> "$LOG"

    cat <<EOF > "$METRIC_FILE"
# HELP restore_success Backup restore status (1=success, 0=failure)
# TYPE restore_success gauge
restore_success 1

# HELP restore_duration_seconds Time taken to restore database
# TYPE restore_duration_seconds gauge
restore_duration_seconds $DURATION

# HELP restore_rows_res_users Number of users in restored DB
# TYPE restore_rows_res_users gauge
restore_rows_res_users $CHECK
EOF

else
    echo "[$(date)] ERRO: validação falhou" >> "$LOG"

    cat <<EOF > "$METRIC_FILE"
# HELP restore_success Backup restore status (1=success, 0=failure)
# TYPE restore_success gauge
restore_success 0
EOF

    exit 1
fi

echo "[$(date)] Teste de restore concluído em ${DURATION}s" >> "$LOG"
